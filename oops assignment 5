#include <iostream>
using namespace std;

class student
{
public:
    string name;
    int rollno;
    float marks;

    student(string name, int rollno, float marks)
    {
        this->name = name;
        this->rollno = rollno;
        this->marks = marks;
    }

    void display()
    {
        cout << "name of the student" << this->name << endl;
        cout << "roll no of the student" << this->rollno << endl;
        cout << "marks of the student" << this->marks << endl;
    }
};

int main()
{
    student s1("shree", 4, 84);
    s1.display();

    return 0;
}
