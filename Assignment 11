#include <iostream>
using namespace std;

template <class T>
void swapValues(T &a, T &b)
{
    T temp;
    temp = a;
    a = b;
    b = temp;
}

int main()
{
    int x = 10, y = 20;
    cout << "Before swapping integers: " << x << " " << y << endl;
    swapValues(x, y);
    cout << "After swapping integers: " << x << " " << y << endl;

    float p = 5.5, q = 8.5;
    cout << "\nBefore swapping floats: " << p << " " << q << endl;
    swapValues(p, q);
    cout << "After swapping floats: " << p << " " << q << endl;

    char c1 = 'A', c2 = 'B';
    cout << "\nBefore swapping characters: " << c1 << " " << c2 << endl;
    swapValues(c1, c2);
    cout << "After swapping characters: " << c1 << " " << c2 << endl;

    return 0;
}
