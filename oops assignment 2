#include <iostream>
#include <string>
using namespace std;

class student
{
public:
    string name;
    int roll_no;
    string course;
    float marks;

    void display()
    {
        cout << "NAME OF STUDENT: " << name << endl;
        cout << "ROLL NUMBER: " << roll_no << endl;
        cout << "COURSE: " << course << endl;
        cout << "MARKS: " << marks << endl;
    }
};

int main()
{
    student s1;

    s1.name = "SHRAVANI";
    s1.roll_no = 101;
    s1.course = "AI AND ML";
    s1.marks = 85.5;

    s1.display();

    return 0;
}
